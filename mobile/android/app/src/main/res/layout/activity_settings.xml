<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR DE CONFIGURAÇÕES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/btn_back"
            android:padding="8dp"
            android:src="@drawable/ic_uptime"
            android:rotation="90"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-bold"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HOST IP -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pref_server_host_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etServerHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:text="192.168.0.126"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PORTA TCP ÁUDIO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pref_audio_port_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etAudioPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="8088"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- PORTA HTTP DISPLAY/SSE -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pref_display_port_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDisplayPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="8080"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- DEVICE ID -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pref_device_id_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:text="celular_mobile"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- TOKEN DE PAREAMENTO -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pref_token_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeviceToken"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- SWITCH TLS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/pref_use_tls_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_use_tls_summary"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>

            <!-- FINGERPRINT DO CERTIFICADO -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutFingerprint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/pref_fingerprint_title"
                android:textColorHint="@color/text_secondary"
                app:boxBackgroundColor="@color/bg_card"
                app:boxStrokeColor="@color/jarvis_cyan"
                app:hintTextColor="@color/jarvis_cyan">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCertFingerprint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- FEEDBACK DE TESTE DE CONEXÃO -->
            <TextView
                android:id="@+id/tvTestFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- BOTÃO TESTAR CONEXÃO -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestConnection"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="12dp"
                android:text="@string/btn_test_conn"
                android:textColor="@color/jarvis_cyan"
                app:strokeColor="@color/jarvis_cyan" />

            <!-- BOTÃO SALVAR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveSettings"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/jarvis_blue"
                android:text="@string/btn_save"
                android:textColor="@color/text_primary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
